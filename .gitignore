# =============================================================================
# Rust
# =============================================================================
# Compiled output and build artifacts
/packages/rust-parser-daemon/target/

# Generated docs
/packages/rust-parser-daemon/doc/

# Object files and libraries from the build script
*.rlib
*.o
*.obj
*.a
*.lib

# NOTE: We DO NOT ignore Cargo.lock. It is important for reproducible builds.

# =============================================================================
# Node.js (for grammars and future frontend)
# =============================================================================
# Dependencies
/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
.next/

# NOTE: We DO NOT ignore package-lock.json or yarn.lock for reproducible builds.

# =============================================================================
# Project-Specific Artifacts (IMPORTANT)
# =============================================================================
# The raw AST output from our parser
**/ast_raw/

# Final packaged output directories
repo.pkg/
pack/

# Week 7: Pack archives
*.zip
reposynth_*.zip
test_hybrid/
test_full/

# Any cloned repositories for processing
temp_repos/

# Worker packs directory (job output files)
worker_packs/

# Local databases and vector stores
*.sqlite
*.sqlite3
*.faiss
*.idx

# =============================================================================
# Secrets & Environment Variables
# =============================================================================
# Ignore all .env files
*.env
*.env.*
# But DO commit example files
!*.env.example
!*.env.sample

# =============================================================================
# Docker
# =============================================================================
# Ignore local overrides for docker-compose
docker-compose.override.yml

# =============================================================================
# RepoSynth Cache (Week 5 - Stage-level caching)
# =============================================================================
# Persistent cache directory for stage outputs
.reposynth_cache/

# =============================================================================
# Legibility benchmark (M2 Task 6) - scratch target config written by
# runner.tool_answer() into each case dir at run time; not a fixture.
# =============================================================================
benchmark/cases/*/.reposynth/
