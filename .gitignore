*.py[cod]
*$py.class$

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# Usually these files are created by pyinstaller, if you push your Pyinstaller
# spec file, then this will suppress the temp files generated when running it
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# =============================================================================
# Rust
# =============================================================================
# Compiled output and build artifacts
/packages/rust-parser-daemon/target/

# Generated docs
/packages/rust-parser-daemon/doc/

# Object files and libraries from the build script
*.rlib
*.o
*.obj
*.a
*.lib

# NOTE: We DO NOT ignore Cargo.lock. It is important for reproducible builds.

# =============================================================================
# Node.js (for grammars and future frontend)
# =============================================================================
# Dependencies
/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
.next/

# NOTE: We DO NOT ignore package-lock.json or yarn.lock for reproducible builds.

# =============================================================================
# Project-Specific Artifacts (IMPORTANT)
# =============================================================================
# The raw AST output from our parser
**/ast_raw/

# Final packaged output directories
repo.pkg/
pack/

# Any cloned repositories for processing
temp_repos/

# Local databases and vector stores
*.sqlite
*.sqlite3
*.faiss
*.idx

# =============================================================================
# Secrets & Environment Variables
# =============================================================================
# Ignore all .env files
*.env
*.env.*
# But DO commit example files
!*.env.example
!*.env.sample

# =============================================================================
# Docker
# =============================================================================
# Ignore local overrides for docker-compose
docker-compose.override.yml